DynValue: trait {
    *self ::
    value(): int;
}

impl DynValue for int {
    *self ::
    value(): int {
        ret unbox self;
    }
}

Node: struct {
    value: int
}

validate_numbers(): int {
    assert (1i8 + 2i8) == 3i8;
    assert (2i16 * 3i16) == 6i16;
    assert (9i32 / 3i32) == 3i32;
    assert (9i64 % 4i64) == 1i64;
    assert (1u8 + 2u8) == 3u8;
    assert (2u16 * 3u16) == 6u16;
    assert (9u32 / 3u32) == 3u32;
    assert (9u64 % 4u64) == 1u64;
    assert ((6 & 3) | (1 ^ 3)) == 2;

    float32: f32 = 1.5f32 + 2.5f32;
    float64: f64 = 9.0f64 / 2.0f64;
    assert cast[int](float32) == 4;
    assert cast[int](float64) == 4;

    ret 40;
}

validate_ownership(): int {
    strong: *Node = box new Node { value: 24 };
    weak: ~Node = strong;
    locked: *Node = lock weak;
    assert locked.value == 24;

    dyn_strong: *DynValue = box 24;
    dyn_weak: ~DynValue = dyn_strong;
    dyn_locked: *DynValue = lock dyn_weak;
    assert dyn_locked.value() == 24;

    ret locked.value + dyn_locked.value();
}

main(): int {
    assert __size_of[std::String] >= 0;
    result: int = validate_numbers() + validate_ownership();
    std::print_int(result);
    ret 0;
}
